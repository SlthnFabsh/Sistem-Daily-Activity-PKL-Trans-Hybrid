# ============ DATABASE (Supabase PostgreSQL) ============
# DATABASE_URL: Transaction pooler (port 6543), dipakai aplikasi saat runtime.
# Wajib diakhiri dengan ?pgbouncer=true
DATABASE_URL=

# DIRECT_URL: Session pooler (port 5432), dipakai Prisma untuk migrasi.
# Harus port 5432, JANGAN memakai URL transaction pooler (6543) untuk ini.
DIRECT_URL=

# ============ AUTH (Auth.js) ============
# AUTH_SECRET: string rahasia untuk menandatangani sesi. npm run setup mengisinya otomatis.
AUTH_SECRET=

# NEXTAUTH_URL: alamat aplikasi (lokal atau Vercel).
NEXTAUTH_URL=http://localhost:3000

# ============ SUPABASE (Storage) ============
# Alamat proyek Supabase, mis. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service role key, diambil dari Dashboard Supabase > Settings > API.
# HANYA dipakai di sisi server. Jangan pernah diakses dari kode client.
SUPABASE_SERVICE_ROLE_KEY=